<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="#FFF8F0"
    android:padding="32dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="⏰"
        android:textSize="64sp"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/alarmTitleText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Task alarm"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#2A2013"
        android:gravity="center"
        android:layout_marginBottom="56dp" />

    <Button
        android:id="@+id/alarmSnoozeBtn"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginBottom="16dp"
        android:text="Snooze 9 min"
        android:textColor="#2A2013"
        android:textSize="16sp"
        android:textStyle="bold"
        android:background="#F0EEE8" />

    <Button
        android:id="@+id/alarmStopBtn"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Stop"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        android:background="#3B8F63" />

</LinearLayout>
